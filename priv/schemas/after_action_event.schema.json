{
  "$id": "eigenforge.after_action_event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge After-Action Event",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.AfterActionEvent",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "after_action_id",
    "command_id",
    "idempotency_key",
    "target",
    "requested_state",
    "status",
    "observed_at",
    "reported_at"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.after_action_event" },
    "schema_version": { "type": "integer", "const": 1 },
    "after_action_id": { "type": "string" },
    "command_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "adapter_attempt_id": { "type": ["string", "null"] },
    "target": { "type": "string" },
    "requested_state": { "type": "string" },
    "observed_state": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "confirmed_changed",
        "confirmed_already_in_state",
        "command_sent_but_unconfirmed",
        "adapter_rejected",
        "adapter_failed",
        "state_mismatch",
        "timed_out"
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "reported_at": { "type": "string", "format": "date-time" },
    "source_observation_ids": { "type": "array", "items": { "type": "string" } },
    "source_fault_event_ids": { "type": "array", "items": { "type": "string" } }
  }
}
