{
  "$id": "eigenforge.device_inventory",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge Device Inventory",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.DeviceInventory",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "rooms"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.device_inventory" },
    "schema_version": { "type": "integer", "const": 1 },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["room_id", "sensors", "actuators"],
        "properties": {
          "room_id": { "type": "string" },
          "sensors": { "type": "array", "items": { "type": "object" } },
          "actuators": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
