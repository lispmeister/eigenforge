{
  "$id": "eigenforge.command_envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge Command Envelope",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.CommandEnvelope",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "command_id",
    "idempotency_key",
    "subject",
    "target",
    "action",
    "scope",
    "requested_state",
    "snapshot_id",
    "snapshot_seq",
    "decision_event_id",
    "reasoner_outcome_event_id",
    "capability_event_id",
    "policy_decision_id",
    "issued_at",
    "expires_at",
    "payload_hash",
    "signature_version",
    "signature"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.command_envelope" },
    "schema_version": { "type": "integer", "const": 1 },
    "command_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "subject": { "type": "string" },
    "target": { "type": "string" },
    "action": { "type": "string" },
    "scope": { "type": "string" },
    "requested_state": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "snapshot_seq": { "type": "integer" },
    "decision_event_id": { "type": "string" },
    "reasoner_outcome_event_id": { "type": "string" },
    "capability_event_id": { "type": "string" },
    "policy_decision_id": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "payload_hash": { "type": "string" },
    "signature_version": { "type": "string" },
    "signature": { "type": "string" }
  }
}
