{
  "$id": "eigenforge.ledger_event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge Ledger Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.LedgerEvent",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "event_id",
    "sequence",
    "event_type",
    "core_node_id",
    "consensus_decision_id",
    "consensus_status",
    "quorum_ref",
    "subject",
    "source_app",
    "occurred_at",
    "persisted_at",
    "payload",
    "payload_hash",
    "previous_event_hash",
    "event_hash",
    "signature_version",
    "signature"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.ledger_event" },
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string" },
    "sequence": { "type": "integer" },
    "event_type": {
      "type": "string",
      "enum": [
        "ledger_genesis",
        "connection_status_observed",
        "io_fault_observed",
        "reasoner_outcome_recorded",
        "capability_check_recorded",
        "policy_decision_recorded",
        "command_envelope_issued",
        "after_action_recorded",
        "stale_snapshot_denied",
        "node_fault_observed"
      ]
    },
    "core_node_id": { "type": "string" },
    "consensus_decision_id": { "type": ["string", "null"] },
    "consensus_status": {
      "type": ["string", "null"],
      "enum": ["single_core_finalized", "quorum_finalized", null]
    },
    "quorum_ref": { "type": "object" },
    "causation_id": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "subject": { "type": "string" },
    "source_app": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "persisted_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "payload_hash": { "type": "string" },
    "previous_event_hash": { "type": "string" },
    "event_hash": { "type": "string" },
    "signature_version": { "type": "string" },
    "signature": { "type": "string" }
  }
}
