{
  "$id": "eigenforge.signed_proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge Signed Proposal",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.SignedProposal",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "proposal_id",
    "proposal_kind",
    "normalized_outcome",
    "core_node_id",
    "consensus_decision_id",
    "snapshot_id",
    "snapshot_seq",
    "snapshot_hash",
    "subject",
    "target",
    "action",
    "scope",
    "requested_state",
    "idempotency_key",
    "issued_at",
    "reasoner_outcome_id",
    "policy_decision_id",
    "payload_hash",
    "signature_version",
    "signature"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.signed_proposal" },
    "schema_version": { "type": "integer", "const": 1 },
    "proposal_id": { "type": "string" },
    "proposal_kind": { "type": "string" },
    "normalized_outcome": { "type": "string" },
    "core_node_id": { "type": "string" },
    "consensus_decision_id": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "snapshot_seq": { "type": "integer" },
    "snapshot_hash": { "type": "string" },
    "subject": { "type": "string" },
    "target": { "type": "string" },
    "action": { "type": "string" },
    "scope": { "type": "string" },
    "requested_state": { "type": ["string", "null"] },
    "idempotency_key": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "reasoner_outcome_id": { "type": "string" },
    "policy_decision_id": { "type": "string" },
    "payload_hash": { "type": "string" },
    "signature_version": { "type": "string" },
    "signature": { "type": "string" }
  }
}
