{
  "$id": "eigenforge.io_fault_status_event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eigenforge IO Fault/Status Event",
  "type": "object",
  "additionalProperties": false,
  "x-elixir-module": "Eigenforge.Contracts.IoFaultStatusEvent",
  "x-format-version": "json-canonical-v1",
  "x-schema-version": 1,
  "required": [
    "format_version",
    "schema_id",
    "schema_version",
    "event_id",
    "room_id",
    "source",
    "fault_type",
    "observed_at"
  ],
  "properties": {
    "format_version": { "type": "string", "const": "json-canonical-v1" },
    "schema_id": { "type": "string", "const": "eigenforge.io_fault_status_event" },
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string" },
    "room_id": { "type": "string" },
    "source": { "type": "string" },
    "fault_type": {
      "type": "string",
      "enum": [
        "connection_up",
        "connection_down",
        "reconnecting",
        "degraded",
        "recovered",
        "malformed_observation",
        "adapter_execution_failed",
        "adapter_rejected",
        "command_expired",
        "duplicate_idempotency_key",
        "invalid_command_signature"
      ]
    },
    "message": { "type": ["string", "null"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
